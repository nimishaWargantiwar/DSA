class Solution {
    public boolean isValidSudoku(char[][] board) {
       for(int i=0;i<9;i++)
       {
        for(int j=0;j<9;j++)
        {
            char num=board[i][j];

            if(num=='.')
            {
                continue;
            }
            board[i][j]='.';

            if(!isvalid(board,i,j,num))
            {
                return false;
            }

             board[i][j]=num;
        }
       }
       return true;
    }

    public boolean isvalid(char board[][],int r,int c,int num)
    {
        for(int i=0;i<9;i++)
        {
            if(board[r][i]==num)
            {
                return false;
            }
        }

        for(int i=0;i<9;i++)
        {
            if(board[i][c]==num)
            {
                return false;
            }
        }

        int sr=(r/3)*3;
        int sc=(c/3)*3;

        for(int i=sr;i<sr+3;i++)
        {
            for(int j=sc;j<sc+3;j++)
            {
                if(board[i][j]==num)
                {
                    return false;
                }
            }
        }
        return true;

    }
}























class Solution {
    public int minFallingPathSum(int[][] matrix) {
        Integer dp[][]=new Integer[matrix.length][matrix[0].length];

        int ans=Integer.MAX_VALUE;

        for(int i=0;i<matrix.length;i++)
        {
            ans=Math.min(ans,solve(matrix,0,i,dp));
        }
        return ans;
    }

    public int solve(int mat[][],int r,int c,Integer dp[][])
    {
        int m=mat.length;
        int n=mat[0].length;

        if(c<0 || c>=n)
        {
            return Integer.MAX_VALUE;
        }

        if(r==n-1)
        {
            return mat[r][c];
        }

        if(dp[r][c]!=null)
        {
            return dp[r][c];
        }

        int ldiagonal=solve(mat,r+1,c-1,dp);
        int bottom=solve(mat,r+1,c,dp);
        int rdiagonal=solve(mat,r+1,c+1,dp);

        dp[r][c]=mat[r][c]+Math.min(ldiagonal,Math.min(rdiagonal,bottom));

        return dp[r][c];


    }
}
